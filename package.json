{
  "name": "@ds-mo/icons",
  "version": "8.0.0",
  "description": "IcoMo — 448 SVG icons (400 system icons + 32 country flags + 16 map icons) as tree-shakeable React components, framework-agnostic SVG strings, TypeScript definitions, and SVG sprite",
  "keywords": [
    "icons",
    "svg",
    "react",
    "icon-library",
    "design-system",
    "tree-shakeable",
    "typescript",
    "flags",
    "country-flags",
    "map-icons",
    "map-markers",
    "compomo",
    "ds-mo"
  ],
  "homepage": "https://zainadeel.github.io/icomo/",
  "bugs": "https://github.com/zainadeel/icomo/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/zainadeel/icomo.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./icons/*": {
      "import": "./dist/icons/*.mjs",
      "types": "./dist/icons/*.d.ts"
    },
    "./flags": {
      "import": "./dist/flags/index.mjs",
      "types": "./dist/flags/index.d.ts"
    },
    "./flags/*": {
      "import": "./dist/flags/*.mjs",
      "types": "./dist/flags/*.d.ts"
    },
    "./map": {
      "import": "./dist/map/index.mjs",
      "types": "./dist/map/index.d.ts"
    },
    "./map/*": {
      "import": "./dist/map/*.mjs",
      "types": "./dist/map/*.d.ts"
    },
    "./svg": {
      "import": "./dist/svg/index.mjs",
      "types": "./dist/svg/index.d.ts"
    },
    "./svg/flags": {
      "import": "./dist/svg/flags/index.mjs",
      "types": "./dist/svg/flags/index.d.ts"
    },
    "./svg/flags/*": {
      "import": "./dist/svg/flags/*.mjs",
      "types": "./dist/svg/flags/*.d.ts"
    },
    "./svg/map": {
      "import": "./dist/svg/map/index.mjs",
      "types": "./dist/svg/map/index.d.ts"
    },
    "./svg/map/*": {
      "import": "./dist/svg/map/*.mjs",
      "types": "./dist/svg/map/*.d.ts"
    },
    "./svg/*": {
      "import": "./dist/svg/*.mjs",
      "types": "./dist/svg/*.d.ts"
    },
    "./sprite": "./dist/sprite.svg",
    "./svg-files/*": "./dist/svg-files/*.svg",
    "./meta": {
      "import": "./dist/meta.mjs",
      "types": "./dist/meta.d.ts",
      "default": "./dist/meta.json"
    },
    "./meta.json": "./dist/meta.json",
    "./agent": {
      "import": "./dist/agent.mjs",
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.json"
    },
    "./agent.json": "./dist/agent.json",
    "./createIcon": {
      "import": "./dist/createIcon.mjs",
      "types": "./dist/createIcon.d.ts"
    },
    "./createFlagIcon": {
      "import": "./dist/createFlagIcon.mjs",
      "types": "./dist/createFlagIcon.d.ts"
    },
    "./createMapIcon": {
      "import": "./dist/createMapIcon.mjs",
      "types": "./dist/createMapIcon.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:svg": "node scripts/generate-svg-files.mjs",
    "validate": "node scripts/validate-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/build.mjs --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.12.1"
}
